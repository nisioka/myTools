#!/bin/bash
# ws - Workspace Manager
#
# IDEのターミナルで ws add → tmuxセッション開始（セッション名=ディレクトリ名）
# 別モニターで ws dash → 全セッションをミラーして一覧表示
#
# コマンド:
#   ws add [-g group] [name]         - tmuxセッションを作成しattach（-gでグループ付与）
#   ws rm [name]                     - セッションを終了（名前省略=ディレクトリ名）
#   ws list [-g group] [-G group]    - 一覧表示（-g: 絞り込み、-G: 除外）
#   ws dash [-g group] [-G group]    - ダッシュボードを開く（-g: 絞り込み、-G: 除外）
#   ws help                          - ヘルプ

WS_PREFIX="ws-"
WS_GROUP_FILE="$HOME/.config/ws/groups"

_session_name() {
    local name="${1//\./_}"
    name="${name//:/_}"
    echo "${WS_PREFIX}${name}"
}

_list_ws() {
    tmux list-sessions -F '#S' 2>/dev/null | grep "^${WS_PREFIX}" | sed "s/^${WS_PREFIX}//"
}

_ensure_group_file() {
    [ -f "$WS_GROUP_FILE" ] || { mkdir -p "$(dirname "$WS_GROUP_FILE")"; touch "$WS_GROUP_FILE"; }
}

_set_group() {
    local name="$1" group="$2"
    _ensure_group_file
    _remove_group "$name"
    printf '%s\t%s\n' "$name" "$group" >> "$WS_GROUP_FILE"
}

_get_group() {
    [ -f "$WS_GROUP_FILE" ] || return
    awk -F'\t' -v n="$1" '$1==n{print $2; exit}' "$WS_GROUP_FILE"
}

_remove_group() {
    [ -f "$WS_GROUP_FILE" ] || return
    local tmp_file
    tmp_file=$(mktemp)
    awk -F'\t' -v n="$1" '$1!=n' "$WS_GROUP_FILE" > "$tmp_file"
    mv "$tmp_file" "$WS_GROUP_FILE"
}

# フィルタ条件ごとに一意なダッシュボードセッション名を生成する。
# これにより -g / -G の組み合わせが異なれば独立したダッシュボードになる。
_dash_name() {
    local include="$1" exclude="$2"
    local key="dash"
    [ -n "$include" ] && key="${key}__g_${include}"
    [ -n "$exclude" ] && key="${key}__x_${exclude}"
    key="${key//[.: ]/_}"
    echo "$key"
}

_list_ws_filtered() {
    local include="$1" exclude="$2"
    local sessions
    sessions=$(_list_ws)
    [ -z "$sessions" ] && return

    declare -A groups
    if [ -f "$WS_GROUP_FILE" ]; then
        while IFS=$'\t' read -r name group; do
            groups["$name"]="$group"
        done < "$WS_GROUP_FILE"
    fi

    while read -r name; do
        local grp="${groups[$name]}"
        if [ -n "$include" ] && [ "$grp" != "$include" ]; then
            continue
        fi
        if [ -n "$exclude" ] && [ "$grp" = "$exclude" ]; then
            continue
        fi
        echo "$name"
    done <<< "$sessions"
}

_build_panes() {
    # 新しいウィンドウにペインを構築する共通処理
    # 引数: mode dash_name sessions
    #   mode: "new" (新規セッション作成) または "window" (既存セッションに新ウィンドウ追加)
    local mode="$1"
    local dash_name="$2"
    local sessions="$3"

    # 最初のペインIDを anchor として保持し、以降の分割・レイアウトは
    # 必ずペインID（曖昧さのない target-pane）を基準に行う。
    # 注: split-window の -t はペイン対象で、"=session" 形式では解決できず
    #     "can't find pane" になるため、必ずペインIDを渡す。
    local anchor="" first=true
    while read -r name; do
        local sess="$(_session_name "$name")"
        local pid
        if $first; then
            if [ "$mode" = "new" ]; then
                pid=$(tmux -L ws-dash new-session -d -P -F '#{pane_id}' -s "$dash_name" \
                    "unset TMUX; tmux attach -t '=$sess'")
            else
                pid=$(tmux -L ws-dash new-window -t "=$dash_name" -P -F '#{pane_id}' \
                    "unset TMUX; tmux attach -t '=$sess'")
            fi
            anchor="$pid"
            first=false
        else
            pid=$(tmux -L ws-dash split-window -t "$anchor" -P -F '#{pane_id}' \
                "unset TMUX; tmux attach -t '=$sess'")
            tmux -L ws-dash select-layout -t "$anchor" tiled
        fi
        # ペインID指定でタイトルを設定（"現在のペイン"に依存せず確実に）
        [ -n "$pid" ] && tmux -L ws-dash select-pane -t "$pid" -T "$name"
    done <<< "$sessions"

    [ -z "$anchor" ] && return

    # ペイン数に応じてレイアウト選択（横並び優先）
    local pane_count
    pane_count=$(tmux -L ws-dash list-panes -t "$anchor" 2>/dev/null | wc -l)
    if [ "$pane_count" -le 3 ]; then
        tmux -L ws-dash select-layout -t "$anchor" even-horizontal
    else
        tmux -L ws-dash select-layout -t "$anchor" tiled
    fi
    # 注: set-option / show-options は '=' 完全一致プレフィクスを受け付けないため
    #     セッション名はそのまま渡す（完全一致のセッションが存在すれば優先される）
    tmux -L ws-dash set-option -t "$dash_name" pane-border-status top 2>/dev/null
    tmux -L ws-dash set-option -t "$dash_name" pane-border-format ' #T ' 2>/dev/null
}

_rebuild_dash() {
    local include="$1" exclude="$2"
    local dash_name
    dash_name=$(_dash_name "$include" "$exclude")
    local sessions
    sessions=$(_list_ws_filtered "$include" "$exclude")
    local count=0
    [ -n "$sessions" ] && count=$(echo "$sessions" | wc -l)

    if [ "$count" -eq 0 ]; then
        tmux -L ws-dash kill-session -t "=$dash_name" 2>/dev/null
        echo "ワークスペースがありません"
        return 1
    fi

    if tmux -L ws-dash has-session -t "=$dash_name" 2>/dev/null; then
        # ダッシュボードが開いている場合: 新ウィンドウを作って古いのを消す
        local old_windows
        old_windows=$(tmux -L ws-dash list-windows -t "=$dash_name" -F '#{window_id}')

        _build_panes window "$dash_name" "$sessions"

        # 古いウィンドウを削除（クライアントは新ウィンドウに自動切替済み）
        for wid in $old_windows; do
            tmux -L ws-dash kill-window -t "$wid" 2>/dev/null
        done
    else
        # ダッシュボードが無い場合: 新規作成
        _build_panes new "$dash_name" "$sessions"
    fi

    # このダッシュボードのフィルタ条件をセッションに保存する。
    # add / rm による自動更新時に、各ダッシュボードのフィルタを復元するため。
    # （set-option は '=' プレフィクス不可なので名前をそのまま渡す）
    tmux -L ws-dash set-option -t "$dash_name" @ws-include "$include" 2>/dev/null
    tmux -L ws-dash set-option -t "$dash_name" @ws-exclude "$exclude" 2>/dev/null
}

# 現在開いている全ダッシュボードを、それぞれ保存済みのフィルタ条件で再構築する。
_rebuild_all_dashes() {
    local dashes
    dashes=$(tmux -L ws-dash list-sessions -F '#S' 2>/dev/null)
    [ -z "$dashes" ] && return
    while read -r d; do
        [ -z "$d" ] && continue
        local inc exc
        inc=$(tmux -L ws-dash show-options -t "$d" -qv @ws-include 2>/dev/null)
        exc=$(tmux -L ws-dash show-options -t "$d" -qv @ws-exclude 2>/dev/null)
        _rebuild_dash "$inc" "$exc" >/dev/null
    done <<< "$dashes"
}

cmd_add() {
    local group=""
    local OPTIND=1
    while getopts "g:" opt; do
        case "$opt" in
            g) group="$OPTARG" ;;
            *) cmd_help; return 1 ;;
        esac
    done
    shift $((OPTIND - 1))

    local name="${1:-$(basename "$PWD")}"
    local sess="$(_session_name "$name")"

    if [ -n "$group" ]; then
        _set_group "$name" "$group"
    fi

    if tmux has-session -t "=$sess" 2>/dev/null; then
        if [ -n "$group" ]; then
            echo "✓ '$name' のグループを '$group' に設定しました"
        fi
        echo "⚠ '$name' は既に存在します。attachします"
        exec tmux attach -t "=$sess"
    fi

    tmux new-session -d -s "$sess"

    if [ -n "$(tmux -L ws-dash list-sessions -F '#S' 2>/dev/null)" ]; then
        _rebuild_all_dashes
        echo "ダッシュボードを更新しました"
    fi

    exec tmux attach -t "=$sess"
}

cmd_rm() {
    local name="${1:-$(basename "$PWD")}"
    local sess="$(_session_name "$name")"

    if ! tmux has-session -t "=$sess" 2>/dev/null; then
        echo "⚠ '$name' は存在しません"
        return 1
    fi

    local has_dash=false
    [ -n "$(tmux -L ws-dash list-sessions -F '#S' 2>/dev/null)" ] && has_dash=true

    tmux kill-session -t "=$sess"
    _remove_group "$name"
    echo "✓ '$name' を終了しました"

    # セッションを消してから各ダッシュボードを再構築する。
    # フィルタで対象外になったダッシュボードは自動的に該当ペインが消え、
    # 空になったダッシュボードはセッションごと閉じられる。
    if $has_dash; then
        _rebuild_all_dashes
        echo "  ダッシュボードを更新しました"
    fi
}

cmd_list() {
    local include="" exclude=""
    local OPTIND=1
    while getopts "g:G:" opt; do
        case "$opt" in
            g) include="$OPTARG" ;;
            G) exclude="$OPTARG" ;;
            *) cmd_help; return 1 ;;
        esac
    done
    shift $((OPTIND - 1))

    local sessions
    sessions=$(_list_ws_filtered "$include" "$exclude")
    if [ -z "$sessions" ]; then
        echo "アクティブなワークスペースはありません"
        return
    fi
    echo "ワークスペース:"
    declare -A groups
    if [ -f "$WS_GROUP_FILE" ]; then
        while IFS=$'\t' read -r gname ggroup; do
            groups["$gname"]="$ggroup"
        done < "$WS_GROUP_FILE"
    fi

    while read -r name; do
        local sess="$(_session_name "$name")"
        local dir
        dir=$(tmux display-message -t "=$sess" -p '#{pane_current_path}' 2>/dev/null)
        local grp="${groups[$name]}"
        if [ -n "$grp" ]; then
            echo "  $name  [$grp]  ($dir)"
        else
            echo "  $name  ($dir)"
        fi
    done <<< "$sessions"
}

cmd_dash() {
    local include="" exclude=""
    local OPTIND=1
    while getopts "g:G:" opt; do
        case "$opt" in
            g) include="$OPTARG" ;;
            G) exclude="$OPTARG" ;;
            *) cmd_help; return 1 ;;
        esac
    done
    shift $((OPTIND - 1))

    _rebuild_dash "$include" "$exclude" || return
    local dash_name
    dash_name=$(_dash_name "$include" "$exclude")
    exec tmux -L ws-dash attach -t "=$dash_name"
}

cmd_help() {
    cat << 'EOF'
ws - Workspace Manager

コマンド:
  ws add [-g group] [name]   tmuxセッションを作成してattach（名前省略=ディレクトリ名）
  ws rm [name]               セッションを終了（名前省略=ディレクトリ名）
  ws list [-g group] [-G group]  一覧表示
  ws dash [-g group] [-G group]  ミラーダッシュボードを開く
  ws help                    このヘルプ

グループオプション:
  -g group   グループ名を指定（addでは付与、list/dashでは絞り込み）
  -G group   指定グループを除外（list/dashで使用）

使い方:
  # 各IDEのターミナルで
  cd ~/projects/api && ws add -g backend    # → "ws-api" をbackendグループで作成
  cd ~/projects/web && ws add -g frontend   # → "ws-web" をfrontendグループで作成
  cd ~/projects/db && ws add                # → "ws-db" をグループなしで作成

  # グループで絞り込み
  ws list -g backend              # → backendグループのみ表示
  ws list -G frontend             # → frontendグループを除外して表示
  ws dash -g backend              # → backendグループのみダッシュボード表示

  # 別モニター / 別ターミナルで
  ws dash                           # → 全セッションがタイル表示でミラー

  # フィルタごとに独立したダッシュボード（別ウィンドウで併用可能）
  ws dash -g backend                # → backend専用ダッシュボード
  ws dash -g frontend               # → frontend専用ダッシュボード（上とは別セッション）
  # ↑ 2つは別ウィンドウで同時に開いたままにできる。
  #    ws add / ws rm 後もそれぞれのフィルタを維持して自動更新される。

  # 既存セッションにグループを後付け
  ws add -g backend api             # → 既存の"api"にbackendグループを設定

ダッシュボード操作:
  Ctrl+B → 矢印   ペイン間移動（入力もできる）
  Ctrl+B → D       ダッシュボードから抜ける

セッション増減時:
  ws add / ws rm 後、ダッシュボードは自動更新
  手動更新は別ターミナルで ws dash を再実行
EOF
}

case "${1:-help}" in
    add)  shift; cmd_add "$@" ;;
    rm)   shift; cmd_rm "$@" ;;
    list) shift; cmd_list "$@" ;;
    dash) shift; cmd_dash "$@" ;;
    help|--help|-h) cmd_help ;;
    *)    echo "不明なコマンド: $1"; cmd_help; exit 1 ;;
esac
